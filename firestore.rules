rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^\\d{2}:\\d{2}$');
    }

    function isValidPriority(p) {
      return p is string && (p == 'baja' || p == 'media' || p == 'alta');
    }

    function hasValidUserParent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'seeded', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseClass(data, userId, classId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'topic', 'date', 'startTime',
          'durationMinutes', 'instructor', 'location', 'priority', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'topic', 'date', 'startTime',
          'durationMinutes', 'instructor', 'location', 'priority', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == classId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80
        && isValidDateStr(data.date)
        && isValidTimeStr(data.startTime)
        && data.durationMinutes is number && data.durationMinutes >= 15 && data.durationMinutes <= 480
        && data.instructor is string && data.instructor.size() <= 80
        && data.location is string && data.location.size() <= 120
        && isValidPriority(data.priority)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseTask(data, userId, taskId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'description', 'dueDate',
          'topic', 'completed', 'priority', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'dueDate',
          'topic', 'completed', 'priority', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == taskId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 1000
        && isValidDateStr(data.dueDate)
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80
        && data.completed is bool
        && isValidPriority(data.priority)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseNote(data, userId, noteId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'topic', 'content',
          'date', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'topic', 'content',
          'date', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == noteId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && isValidDateStr(data.date)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. User Root Document (No directory listing)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'seeded', 'updatedAt']);

      allow delete: if false;

      // 5. Course Classes Subcollection
      match /classes/{classId} {
        allow get: if isValidId(userId) && isValidId(classId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(classId)
          && isOwner(userId)
          && isValidCourseClass(incoming(), userId, classId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidUserParent(userId);

        allow update: if isValidId(userId)
          && isValidId(classId)
          && isOwner(userId)
          && isValidCourseClass(incoming(), userId, classId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidUserParent(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'topic', 'date', 'startTime', 'durationMinutes', 'instructor', 'location', 'priority', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId) && isValidId(classId) && isOwner(userId);
      }

      // 6. Course Tasks Subcollection
      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidCourseTask(incoming(), userId, taskId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidUserParent(userId);

        allow update: if isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidCourseTask(incoming(), userId, taskId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidUserParent(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'dueDate', 'topic', 'completed', 'priority', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      // 7. Course Notes Subcollection
      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isValidCourseNote(incoming(), userId, noteId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidUserParent(userId);

        allow update: if isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isValidCourseNote(incoming(), userId, noteId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasValidUserParent(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'topic', 'content', 'date', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
      }
    }
  }
}
